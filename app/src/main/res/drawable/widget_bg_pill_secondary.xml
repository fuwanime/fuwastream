<?xml version="1.0" encoding="utf-8"?>
<!-- Fully rounded secondaryContainer pill (type labels).
     Used below Android 12 only, where Glance's cornerRadius is a no-op; the color follows the
     system night mode through values-night, matching ColorProviders(LightScheme, DarkScheme). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="@dimen/widget_radius_pill" />
    <solid android:color="@color/widget_secondary_container" />
</shape>
